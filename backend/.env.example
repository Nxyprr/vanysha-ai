# Copia este archivo como ".env" y cambia lo que necesites. Todas las variables son opcionales.

# --- Seguridad ---
VANYSHA_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
VANYSHA_ADMIN_EMAIL=admin@vanysha.ai
VANYSHA_ADMIN_PASSWORD=Cambia-Esta-Clave-123
VANYSHA_ADMIN_NAME=Administradora
VANYSHA_TOKEN_HOURS=12

# --- Detección: auto | yolo | hog | demo ---
VANYSHA_DETECTOR=auto
VANYSHA_MODEL=yolov8n.pt
VANYSHA_CONF=0.4

# --- Reglas en vivo ---
VANYSHA_ZONE_SECONDS=0.6
VANYSHA_COOLDOWN=8
VANYSHA_CROWD_LIMIT=5

# --- Datos ---
# VANYSHA_DATA_DIR=./data
# Si sirves el frontend desde otro dominio:
# VANYSHA_ORIGINS=https://mi-frontend.com
